# Example configuration — copy to `.env` and adjust locally.
# Illustrative values only; never commit real credentials.

# Application environment: development | testing | production
APP_ENV=development

# Flask secret key (sessions/flash messages). Use a long random string in production.
SECRET_KEY=dev-only-not-a-secret-change-me

# SQLite database file location (relative to the instance/ folder)
DATABASE_PATH=dunbar_vet.sqlite3

# Local server settings
HOST=127.0.0.1
PORT=5000
